{
  "name": "seas-bootcamp",
  "version": "1.0.0",
  "description": "SEAS Bootcamp web application — IUC Douala, Cameroon",
  "main": "server.js",
  "scripts": {
    "start":   "node server.js",
    "dev":     "nodemon server.js",
    "test":    "jest --testPathPattern=tests/ --forceExit --detectOpenHandles",
    "lint":    "eslint . --ext .js",
    "lint:fix":"eslint . --ext .js --fix"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "server.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 50
      }
    },
    "testTimeout": 30000
  },
  "dependencies": {
    "cors":       "^2.8.5",
    "dotenv":     "^16.3.1",
    "express":    "^4.18.2",
    "nodemailer": "^6.9.7",
    "pg":         "^8.11.3"
  },
  "devDependencies": {
    "eslint":    "^8.57.0",
    "jest":      "^29.7.0",
    "nodemon":   "^3.0.2",
    "supertest": "^6.3.3"
  },
  "author": "NGUEUTUE KAMGA MODESTE VIKASH",
  "license": "MIT"
}
